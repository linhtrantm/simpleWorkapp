{
  "name": "simplework",
  "productName": "simpleWork",
  "version": "1.7.2",
  "description": "simpleWork - gom Zalo, WhatsApp, Teams vào một cửa sổ",
  "main": "src/main.js",
  "author": "simplesoft",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build.js",
    "release": "node scripts/release.js",
    "test": "node scripts/test-daytask.js && node scripts/test-theme.js && node scripts/test-updater.js"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.simplesoft.simplework",
    "productName": "simpleWork",
    "asar": true,
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": { "artifactName": "simpleWork-${version}-build${buildVersion}-${arch}.${ext}" }
  }
}
